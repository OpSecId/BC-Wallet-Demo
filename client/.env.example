SNOWPLOW_ENDPOINT=spm.apps.gov.bc.ca
# Optional: set to true to skip Snowplow even on non-localhost builds
# REACT_APP_DISABLE_SNOWPLOW=true
# API + Socket.IO origin only (no path, no trailing slash). Axios uses this + BASE_ROUTE.
# Local stack: http://127.0.0.1:5000
# Local UI + deployed API: https://your-host.example.com
# After changing REACT_APP_* you must stop and restart `yarn client:start` (not hot reload).
REACT_APP_HOST_BACKEND=http://127.0.0.1:5000
# Must match the server BASE_ROUTE (e.g. Railway BASE_ROUTE).
REACT_APP_BASE_ROUTE=/digital-trust/showcase
REACT_APP_INSIGHTS_PROJECT_ID=