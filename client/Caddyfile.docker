# Static SPA — API calls use REACT_APP_HOST_BACKEND in the browser (BaseUrl.ts).
# Railway sets PORT.

:{$PORT}

encode gzip zstd

log {
	output stdout
}

handle /health {
	respond "ok" 200
}

handle /digital-trust/showcase {
	redir /digital-trust/showcase/ 308
}

# IMPORTANT: /digital-trust/showcase/* must come BEFORE /digital-trust/showcase/
# Otherwise Caddy treats the latter as a prefix and rewrites JS/CSS to index.html (white page).

handle /digital-trust/showcase/* {
	uri strip_prefix /digital-trust/showcase
	root * /srv/digital-trust/showcase
	try_files {path} /index.html
	file_server
}

handle /digital-trust/showcase/ {
	uri strip_prefix /digital-trust/showcase
	root * /srv/digital-trust/showcase
	try_files {path} /index.html
	file_server
}

handle {
	redir /digital-trust/showcase/ 308
}
